{
    "name": "portfolio-dev/personal-finance-api",
    "description": "Layered PHP API for a multi-account personal finance manager",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "recurring": "php bin/run-recurring.php",
        "serve": "php -d upload_max_filesize=15M -d post_max_size=16M -S localhost:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
