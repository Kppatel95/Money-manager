# Copy this file to .env and adjust as needed. Every value has a working
# default, so the API runs without a .env at all -- which is fine for a local
# demo and not fine anywhere else, because the JWT secret would be the
# published default.

# Secret used to sign access tokens. Use a long, random value in production.
JWT_SECRET=change-this-to-a-long-random-string

# Access-token lifetime in seconds. Short on purpose: a JWT cannot be revoked,
# so the refresh token (7 days, revocable, rotated on use) carries the
# long-lived half of the session.
JWT_TTL=900

# Path to the SQLite database file. If omitted, defaults to
# backend/database/finance.sqlite. If you set it, use an absolute path -- it is
# resolved relative to whatever directory the PHP server was started from, not
# relative to this file.
# DB_PATH=/absolute/path/to/finance.sqlite

# Application log. Defaults to backend/storage/logs/app.log.
# LOG_PATH=/absolute/path/to/app.log
# LOG_LEVEL=debug

# Set to "true" to include exception messages and stack traces in 500
# responses. Development only.
APP_DEBUG=false

# Powers "scan a bill" (POST /bill-scans): the API sends the uploaded receipt
# or PDF to Claude and asks it to extract one transaction per bill found.
# Get a key at https://console.anthropic.com/. Without one, the endpoint
# returns a clear error instead of a transaction.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
