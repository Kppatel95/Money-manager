# Copy this file to .env and adjust as needed.

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET=change-this-to-a-long-random-string

# Path to the SQLite database file. If omitted, defaults to
# backend/database/expenses.sqlite. If you set it, use an absolute path
# (it's resolved relative to whatever directory the PHP server is started
# from, not this file).
# DB_PATH=/absolute/path/to/expenses.sqlite

# Set to "true" to include exception messages in 500 responses (dev only).
APP_DEBUG=false
